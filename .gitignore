__pycache__/
*.pyc
kernel_cache/
resources/flashinfer-*
resources/flashinfer.tar.gz
resources/cutlass-*
resources/cutlass.tar.gz
resources/DeepGEMM
resources/moe-artifacts/
resources/moe-artifacts-v031/
resources/trtllm-gen-artifacts/
test_results*.json
